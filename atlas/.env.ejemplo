# Las variables de Atlas. En Vercel van en Settings → Environment Variables; para probar en el PC, en un archivo
# .env.local junto a este (no se sube). Nunca pegues sus valores en un chat.

# La clave de Anthropic (la de Aibi u otra): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Un token de GitHub de grano fino, sólo para 4ChrisM/boveda-biplot, con «Contents: Read and write»
GITHUB_TOKEN=

# La contraseña para entrar a la página
ATLAS_CLAVE=

# Un secreto largo para firmar la sesión y las propuestas (por ejemplo, la salida de: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ATLAS_SECRETO=

# Opcionales
# BOVEDA_REPO=4ChrisM/boveda-biplot
# BOVEDA_RAMA=main
# OBSIDIAN_BOVEDA=Biplot           # el nombre de la bóveda en Obsidian, para los enlaces obsidian://
# ATLAS_MODELO=claude-sonnet-5-5
# ATLAS_ESFUERZO=low               # low (más rápido) · medium · high

# Para probar sin GitHub ni Claude (sólo en el PC)
# BOVEDA_LOCAL=C:/Users/.../00. Boveda Biplot   # leer la bóveda desde una carpeta
# BOVEDA_LOCAL_ESCRIBIR=1                      # y dejar que Guardar escriba ahí
# ATLAS_SIMULADO=1                             # un Atlas de prueba, sin Claude
